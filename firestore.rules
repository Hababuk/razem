rules_version = '2';
// Access is limited to the email addresses listed in the Firestore document config/access (field "emails", an array).
// That document is edited only in the Firebase console — the app cannot read or change it — so the list stays private
// even though this repository is public.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function allowed() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/access).data.emails;
    }
    function isMember(hid) {
      return allowed() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    match /config/{doc} { allow read, write: if false; }

    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
      // private tasks, their history and notes: only the owner, never the other member
      match /{coll}/{doc} {
        allow read, write: if allowed() && request.auth.uid == uid && coll in ['ptasks', 'pcomps', 'pnotes'];
      }
    }

    match /households/{hid} {
      allow get: if allowed();
      allow create: if allowed() && request.resource.data.members == [request.auth.uid];
      allow update: if isMember(hid) || (
        // joining: add only yourself (max 2 people), and only your own name/colour
        allowed()
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'colors'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.colors.diff(resource.data.colors).affectedKeys().hasOnly([request.auth.uid])
      );
      allow delete: if false;

      match /{coll}/{doc} {
        allow read: if isMember(hid);
        allow write: if isMember(hid) && coll != 'notify';
      }
    }
  }
}
